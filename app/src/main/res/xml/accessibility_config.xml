<?xml version="1.0" encoding="utf-8"?>
<!--
    canRetrieveWindowContent and canTakeScreenshot are needed only for navigation apps: many of them show
    distance and maneuver only on their own screen. It also reads the timer and stopwatch time in "Clock",
    in case their notifications are off, and the payment amount on a wallet or bank screen while it is
    open: the bank's notification often arrives later or not at all. The island doesn't read other apps. With collapse-with-shade enabled, it reads
    only the system notification panel identifiers.
    The window list (flagRetrieveInteractiveWindows, typeWindowsChanged) is only to know whether the
    keyboard is open while you reply to a notification right in the island.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/a11y_desc"
    android:settingsActivity="com.akira.island.ui.MainActivity"
    android:notificationTimeout="100" />
